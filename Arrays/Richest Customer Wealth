class Solution {
    public int maximumWealth(int[][] accounts) {
        int l = accounts.length;
        int[] ans = new int[l];


        for (int i=0;i<l;i++){
            int count = 0;

            for(int j=0;j<accounts[i].length;j++){
                count+=accounts[i][j];
            }
            ans[i]=count;
        }
        int maxWealth = 0;
        for (int num : ans){
            if (num > maxWealth){
                maxWealth = num;
            }
        }
        return maxWealth;
    }
}
